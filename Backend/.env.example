# MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing secret (cualquier string largo y aleatorio)
SECRET_KEY=your-secret-key-here

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Resend API key para envío de emails (https://resend.com)
RESEND_API_KEY=your-resend-api-key-here

# Dirección de email remitente verificada en Resend
MAIL_FROM=noreply@yourdomain.com

# RabbitMQ broker URL para Celery
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# URL base del backend (usada en links de email)
BASE_URL=http://localhost:8000

# Host del servidor (para el worker de Celery)
SERVER_HOST=localhost
